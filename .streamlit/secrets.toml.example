# Copy to .streamlit/secrets.toml and enter your mail server settings.
# The real secrets.toml is ignored by Git. Do not commit credentials.
[smtp]
host = "smtp.example.com"
port = 587
security = "starttls" # starttls, ssl (usually port 465), or none for a trusted relay
from_email = "planner@example.com"
username = "planner@example.com"
password = ""
# Required: the deployed board address reachable from beta testers' devices.
# The notification adds ?task=<ticket-id> automatically. Do not use localhost for beta.
app_url = "https://planner.example.com"
